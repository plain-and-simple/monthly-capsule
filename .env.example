# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Capsule <capsule@plainandsimple.app>

# Session cookie (HS256). Use a long random string (32+ chars).
COOKIE_SECRET=replace-with-a-long-random-secret

# Public origin (no trailing slash). Production: https://capsule.plainandsimple.app
# No basePath. No /capsule prefix. Separate Vercel project.
APP_URL=http://localhost:3000

# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=replace-with-cron-secret
