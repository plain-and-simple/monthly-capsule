# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Capsule <capsules@plainandsimple.app>

# Session cookie (HS256). Use a long random string (32+ chars).
COOKIE_SECRET=replace-with-a-long-random-secret

# Public origin (no trailing slash). Production: https://capsule.plainandsimple.app
# No basePath. No /capsule prefix. Separate Vercel project.
APP_URL=http://localhost:3000

# Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=replace-with-cron-secret

# Required to create a group (trim + case-insensitive). Default if unset: plainandsimple
CREATE_GROUP_CODE=plainandsimple

# Manage login is email + password on this host. No phone, SMS, or Twilio vars.

# Playwright e2e (never commit real values). Unset E2E_BASE_URL → http://127.0.0.1:3000
# Hitting capsule.plainandsimple.app requires E2E_ALLOW_PRODUCTION=1
E2E_BASE_URL=
E2E_EMAIL=
E2E_PASSWORD=
E2E_GROUP_PIN=
E2E_GROUP_ID=
E2E_CRON_SECRET=
E2E_ALLOW_PRODUCTION=
