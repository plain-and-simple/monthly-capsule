{
  "functions": {
    "src/app/api/cron/compile/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/(app)/g/[uuid]/capsule/[yearMonth]/pdf/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "src/app/(app)/g/[uuid]/capsule/[yearMonth]/[edition]/pdf/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/compile",
      "schedule": "10 6 * * *"
    },
    {
      "path": "/api/cron/email",
      "schedule": "0 15 * * *"
    }
  ]
}
